rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // MVP：僅允許已登入的管理者使用後台資料。
    // 正式上線前請在 users/{uid} 建立 role 欄位，並將此條件收緊為管理者角色。
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'viewer';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function canEdit() {
      return signedIn() && (role() == 'admin' || role() == 'editor');
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'viewer';
      allow update: if isAdmin() || (request.auth.uid == userId
        && request.resource.data.role == resource.data.role);
    }

    match /cases/{caseId} {
      allow read: if signedIn();
      allow create, update: if canEdit();
      allow delete: if isAdmin();
    }

    match /reviewers/{reviewerId} {
      allow read: if signedIn();
      allow create, update: if canEdit();
      allow delete: if isAdmin();
    }

    match /templates/{templateId} {
      allow read: if signedIn();
      allow create, update: if canEdit();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
